NODE_ENV=production

POSTGRES_USER=agents
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=agents
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=4000
FRONTEND_PORT=3000

PORT=4000
CORS_ORIGIN=https://your-domain.example
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
REDIS_URL=redis://redis:6379

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000

SCHEDULER_ENABLED=false
INSTAGRAM_CRON=0 9 * * 1,3,5
LINKEDIN_CRON=0 9 * * 2,4

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram/webhook

LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-domain.example/api/social/linkedin/callback

VITE_API_URL=/api
