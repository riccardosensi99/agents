NODE_ENV=development

# Local development database. Docker Compose overrides DATABASE_URL for containers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agents?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agents
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=4000
FRONTEND_PORT=3000

PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Empty key keeps the backend on deterministic mock responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Prepared for scheduled draft creation. Keep false until you explicitly want it.
SCHEDULER_ENABLED=false
REDIS_URL=redis://redis:6379

# Docker frontend build. /api lets nginx proxy requests to the backend service.
VITE_API_URL=/api
