NODE_ENV=development

# Local development database. Docker Compose overrides DATABASE_URL for containers.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agents?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agents
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=4000
FRONTEND_PORT=3000

PORT=4000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=local-dev-jwt-secret-change-before-production-32
JWT_EXPIRES_IN=7d

# In-memory limiter for this MVP. REDIS_URL is reserved for a future Redis-backed store.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
REDIS_URL=redis://localhost:6380

# Empty key keeps deterministic mock AI responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000

# Scheduler creates draft tasks only. It never publishes to social platforms.
SCHEDULER_ENABLED=false
INSTAGRAM_CRON=0 9 * * 1,3,5
LINKEDIN_CRON=0 9 * * 2,4

# Docker frontend build. /api lets nginx proxy requests to the backend service.
VITE_API_URL=/api
