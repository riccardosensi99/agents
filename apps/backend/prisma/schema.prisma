generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  idle
  working
  waiting_approval
  error
}

enum TaskStatus {
  pending
  running
  completed
  waiting_approval
  rejected
  revision_requested
  failed
}

enum TaskPriority {
  low
  normal
  high
  urgent
}

enum DraftStatus {
  draft
  waiting_approval
  approved
  rejected
  revision_requested
}

enum Platform {
  instagram
  linkedin
  internal
}

enum RiskLevel {
  low
  medium
  high
}

enum RecommendedAction {
  approve
  revise
  reject
}

enum ApprovalAction {
  approve
  reject
  request_revision
  edit
}

enum SocialProvider {
  linkedin
}

enum PublishingStatus {
  pending_manual
  blocked
  published
  failed
}

enum MemoryType {
  EXPERIENCE
  OPINION
  LESSON
  WORKFLOW
  STACK
  CLIENT_CASE
  MISTAKE
  DEPLOY
  CONTENT_EXAMPLE
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("owner")
  approvals    Approval[]
  brandProfile BrandProfile?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Agent {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  role        String
  description String
  status      AgentStatus  @default(idle)
  avatarType  String
  config      Json         @default("{}")
  tasks       Task[]
  drafts      Draft[]
  logs        AgentLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Task {
  id           String       @id @default(uuid())
  agentId      String
  title        String
  prompt       String
  platform     Platform     @default(internal)
  status       TaskStatus   @default(pending)
  priority     TaskPriority @default(normal)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  retryCount   Int          @default(0)
  result       String?
  resultJson   Json?
  error        String?
  errorMessage String?
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  drafts       Draft[]
  events       TaskEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([platform])
  @@index([scheduledAt])
}

model Draft {
  id                 String             @id @default(uuid())
  agentId            String
  taskId             String?
  title              String
  content            String
  platform           Platform
  status             DraftStatus        @default(waiting_approval)
  supervisorScore    Int?
  riskLevel          RiskLevel?
  supervisorFeedback String?
  recommendedAction  RecommendedAction?
  currentVersion      Int                @default(1)
  agent              Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task               Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approvals          Approval[]
  versions           DraftVersion[]
  telegramActions    TelegramApprovalAction[]
  discordActions     DiscordApprovalAction[]
  publishingAttempts PublishingAttempt[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([agentId])
  @@index([taskId])
  @@index([status])
}

model DraftVersion {
  id                 String             @id @default(uuid())
  draftId            String
  version            Int
  title              String
  content            String
  supervisorScore    Int?
  riskLevel          RiskLevel?
  supervisorFeedback String?
  recommendedAction  RecommendedAction?
  userFeedback       String?
  createdBy          String             @default("system")
  draft              Draft              @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())

  @@unique([draftId, version])
  @@index([draftId])
}

model TaskEvent {
  id        String   @id @default(uuid())
  taskId    String
  type      String
  message   String
  meta      Json?
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([type])
}

model AgentLog {
  id        String   @id @default(uuid())
  agentId   String
  level     String   @default("info")
  message   String
  meta      Json?
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([agentId])
}

model Approval {
  id             String         @id @default(uuid())
  draftId        String
  userId         String?
  action         ApprovalAction
  comment        String?
  previousStatus DraftStatus?
  newStatus      DraftStatus?
  draft          Draft          @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([draftId])
  @@index([userId])
}

model SystemEvent {
  id        String   @id @default(uuid())
  level     String   @default("info")
  type      String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
}

model BrandProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  ownerName        String   @default("")
  bio              String   @default("")
  services         String   @default("")
  technicalStack   String   @default("")
  toneOfVoice      String   @default("")
  targetClients    String   @default("")
  businessGoals    String   @default("")
  topicsToPush     String   @default("")
  topicsToAvoid    String   @default("")
  goodPostExamples String   @default("")
  bannedWords      String   @default("")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id        String    @id @default(uuid())
  type      String
  title     String
  message   String
  status    String    @default("unread")
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
  @@index([type])
}

model TelegramApprovalAction {
  id         String         @id @default(uuid())
  draftId    String
  callbackId String         @unique
  action     ApprovalAction
  status     String         @default("received")
  message    String?
  payload    Json?
  draft      Draft          @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([draftId])
  @@index([status])
}

model DiscordApprovalAction {
  id         String         @id @default(uuid())
  draftId    String
  callbackId String         @unique
  action     ApprovalAction
  status     String         @default("received")
  message    String?
  payload    Json?
  draft      Draft          @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([draftId])
  @@index([status])
}

model SocialAccount {
  id                String         @id @default(uuid())
  provider          SocialProvider
  accountName       String
  accountExternalId String?
  status            String         @default("disabled")
  tokenMeta         Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([provider])
  @@index([status])
}

model PublishingAttempt {
  id          String           @id @default(uuid())
  draftId     String
  provider    SocialProvider
  status      PublishingStatus @default(pending_manual)
  payload     Json?
  error       String?
  requestedBy String?
  draft       Draft            @relation(fields: [draftId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([draftId])
  @@index([provider])
  @@index([status])
}

model MemoryEntry {
  id         String     @id @default(uuid())
  title      String
  content    String
  type       MemoryType
  tags       String[]   @default([])
  importance Int        @default(3)
  source     String     @default("manual")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([type])
  @@index([importance])
  @@index([createdAt])
}
